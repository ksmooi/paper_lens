{
  "type": "excalidraw",
  "version": 2,
  "source": "hermes-agent",
  "elements": [
    {
      "type": "text",
      "id": "title",
      "x": 130,
      "y": 0,
      "width": 400,
      "height": 30,
      "text": "AdaGrad vs Adam: 學習率行為對比",
      "fontSize": 24,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "originalText": "AdaGrad vs Adam: 學習率行為對比",
      "autoResize": true
    },
    {
      "type": "rectangle",
      "id": "adagrad-box",
      "x": 40,
      "y": 50,
      "width": 320,
      "height": 220,
      "roundness": { "type": 3 },
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "boundElements": [{ "id": "t_adagrad_title", "type": "text" }]
    },
    {
      "type": "text",
      "id": "t_adagrad_title",
      "x": 100,
      "y": 60,
      "width": 200,
      "height": 25,
      "text": "AdaGrad: 累加梯度平方和",
      "fontSize": 18,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "adagrad-box",
      "originalText": "AdaGrad: 累加梯度平方和",
      "autoResize": true
    },
    {
      "type": "text",
      "id": "adagrad-formula",
      "x": 55,
      "y": 100,
      "width": 290,
      "height": 25,
      "text": "G_t = Σ_{τ=1}^{t} g_{τ}²",
      "fontSize": 16,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "originalText": "G_t = Σ_{τ=1}^{t} g_{τ}²",
      "autoResize": true
    },
    {
      "type": "text",
      "id": "adagrad-point1",
      "x": 55,
      "y": 135,
      "width": 290,
      "height": 20,
      "text": "• 只加不減, 單調遞增 → ∞",
      "fontSize": 16,
      "fontFamily": 1,
      "strokeColor": "#e03131",
      "originalText": "• 只加不減, 單調遞增 → ∞",
      "autoResize": true
    },
    {
      "type": "text",
      "id": "adagrad-point2",
      "x": 55,
      "y": 160,
      "width": 290,
      "height": 20,
      "text": "• LR = α / √G_t → 0 (死掉)",
      "fontSize": 16,
      "fontFamily": 1,
      "strokeColor": "#e03131",
      "originalText": "• LR = α / √G_t → 0 (死掉)",
      "autoResize": true
    },
    {
      "type": "text",
      "id": "adagrad-point3",
      "x": 55,
      "y": 185,
      "width": 290,
      "height": 20,
      "text": "• 稀疏特徵效果好, 但無法長期訓練",
      "fontSize": 16,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "originalText": "• 稀疏特徵效果好, 但無法長期訓練",
      "autoResize": true
    },
    {
      "type": "text",
      "id": "adagrad-point4",
      "x": 55,
      "y": 210,
      "width": 290,
      "height": 20,
      "text": "• 無 momentum, 無 bias correction",
      "fontSize": 16,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "originalText": "• 無 momentum, 無 bias correction",
      "autoResize": true
    },
    {
      "type": "rectangle",
      "id": "adam-box",
      "x": 440,
      "y": 50,
      "width": 350,
      "height": 220,
      "roundness": { "type": 3 },
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "boundElements": [{ "id": "t_adam_title", "type": "text" }]
    },
    {
      "type": "text",
      "id": "t_adam_title",
      "x": 500,
      "y": 60,
      "width": 230,
      "height": 25,
      "text": "Adam: EMA 梯度平方 + Bias Correction",
      "fontSize": 18,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "adam-box",
      "originalText": "Adam: EMA 梯度平方 + Bias Correction",
      "autoResize": true
    },
    {
      "type": "text",
      "id": "adam-formula",
      "x": 455,
      "y": 100,
      "width": 320,
      "height": 25,
      "text": "v_t = β₂·v_{t-1} + (1-β₂)·g_t²",
      "fontSize": 16,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "originalText": "v_t = β₂·v_{t-1} + (1-β₂)·g_t²",
      "autoResize": true
    },
    {
      "type": "text",
      "id": "adam-point1",
      "x": 455,
      "y": 135,
      "width": 320,
      "height": 20,
      "text": "• EMA 有上界 ≈ 近期梯度平方均值",
      "fontSize": 16,
      "fontFamily": 1,
      "strokeColor": "#2f9e44",
      "originalText": "• EMA 有上界 ≈ 近期梯度平方均值",
      "autoResize": true
    },
    {
      "type": "text",
      "id": "adam-point2",
      "x": 455,
      "y": 160,
      "width": 320,
      "height": 20,
      "text": "• SNR = m̂_t/√v̂_t 自動 annealing",
      "fontSize": 16,
      "fontFamily": 1,
      "strokeColor": "#2f9e44",
      "originalText": "• SNR = m̂_t/√v̂_t 自動 annealing",
      "autoResize": true
    },
    {
      "type": "text",
      "id": "adam-point3",
      "x": 455,
      "y": 185,
      "width": 320,
      "height": 20,
      "text": "• Momentum + Adaptive LR + Bias Correction",
      "fontSize": 16,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "originalText": "• Momentum + Adaptive LR + Bias Correction",
      "autoResize": true
    },
    {
      "type": "text",
      "id": "adam-point4",
      "x": 455,
      "y": 210,
      "width": 320,
      "height": 20,
      "text": "• 稀疏/稠密都 work, 預設值通用",
      "fontSize": 16,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "originalText": "• 稀疏/稠密都 work, 預設值通用",
      "autoResize": true
    },
